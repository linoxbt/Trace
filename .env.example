# Trace: copy to .env and fill in. Never commit the real .env.

# Supabase Postgres: the Transaction pooler string (Connect > Transaction pooler), port 6543,
# with the app's own role (trace_app), never postgres or the service role.
DATABASE_URL=postgresql://trace_app.your-project-ref:password@aws-0-your-region.pooler.supabase.com:6543/postgres?sslmode=require
# Optional: the server's CA certificate (PEM) to pin TLS.
DATABASE_CA_CERT=
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# From the webhook you register for https://trace-proof.netlify.app/api/webhooks/paypal
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Orders and payments run on PayPal's Server SDK; "fetch" switches back to the hand-written client.
# PAYPAL_HTTP=fetch
# Trace pays tradespeople directly as a PayPal partner. The merchant ID of the
# business account that owns the REST app, and the BN code PayPal issues to
# partners (optional in the sandbox). The app needs the features PAYMENT,
# REFUND, READ_SELLER_DISPUTE and UPDATE_SELLER_DISPUTE (Disputes API on), and
# the webhook should also send MERCHANT.ONBOARDING.COMPLETED,
# MERCHANT.PARTNER-CONSENT.REVOKED and
# CUSTOMER.MERCHANT-INTEGRATION.SELLER-EMAIL-CONFIRMED.
PAYPAL_PARTNER_MERCHANT_ID=
PAYPAL_BN_CODE=

# The photo check (Claude). Without a key, proofs are refused rather than judged.
ANTHROPIC_API_KEY=
# Optional: override the verifier model (default claude-opus-5-5).
VERIFIER_MODEL=

# Sandbox end-to-end test: the personal sandbox account that approves orders.
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=
# A sandbox business account linked through Connect PayPal: the e2e test's payee.
PAYPAL_SANDBOX_SELLER_MERCHANT_ID=

# true: 60-second review windows and the sandbox require-evidence route. Sandbox only.
DEMO_MODE=false
APP_URL=http://localhost:3000
# Optional: a throwaway PayPal sandbox personal account shown to judges on demo jobs (sandbox only).
DEMO_BUYER_EMAIL=
DEMO_BUYER_PASSWORD=

# Optional: Trace's own emails (the client's job link, sign-off links) through Resend.
# MAIL_FROM is just the address, on a domain verified with Resend; Trace adds its name.
RESEND_API_KEY=
MAIL_FROM=
# Optional: signs the scheduled worker's calls to /api/eval/step (falls back to the PayPal secret).
EVAL_STEP_SECRET=
# Optional: Cloudflare Turnstile on sign-ins; its secret goes in Supabase > Authentication > Attack Protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Worker
WORKER_TICK_MS=30000
PORT=8080

# Tests: a throwaway Postgres database. Its public schema is dropped on every run.
TEST_DATABASE_URL=
