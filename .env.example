# Trace: copy to .env and fill in. Never commit the real .env.

# Supabase Postgres connection: the Session pooler string (Connect > Session pooler), port 5432.
DATABASE_URL=postgres://postgres:password@db.your-project.supabase.co:5432/postgres
# Optional: the server's CA certificate (PEM) to pin TLS.
DATABASE_CA_CERT=
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# From the webhook you register for https://trace-proof.netlify.app/api/webhooks/paypal
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# The photo check (Claude). Without a key, proofs are refused rather than judged.
ANTHROPIC_API_KEY=
# Optional: override the verifier model (default claude-opus-5-5).
VERIFIER_MODEL=

# Sandbox end-to-end test: the personal sandbox account that approves orders.
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=

# true: 60-second review windows and the sandbox require-evidence route. Sandbox only.
DEMO_MODE=false
APP_URL=http://localhost:3000

# Worker
WORKER_TICK_MS=30000
PORT=8080

# Tests: a throwaway Postgres database. Its public schema is dropped on every run.
TEST_DATABASE_URL=
