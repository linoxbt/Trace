{
  "name": "trace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "test": "vitest run",
    "db:migrate": "tsx packages/db/src/cli.ts",
    "worker": "tsx apps/worker/src/main.ts",
    "sandbox:e2e": "tsx scripts/sandbox-e2e.ts",
    "web": "pnpm --filter @trace/web dev",
    "build:web": "pnpm --filter @trace/web build",
    "eval:inject": "tsx scripts/eval-inject.ts",
    "eval:verifier": "tsx scripts/eval-verifier.ts"
  },
  "devDependencies": {
    "@trace/core": "workspace:*",
    "@trace/db": "workspace:*",
    "@trace/engine": "workspace:*",
    "@trace/eval": "workspace:*",
    "@trace/paypal": "workspace:*",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "playwright": "1.63.0",
    "sharp": "0.34.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
